PORT=3000
NODE_ENV=development

# Fallback origin when Origin header is absent or unvalidated (server-to-server, SSR, curl)
FRONTEND_URL=https://www.growrichmindset.in

# Comma-separated list of permitted origins for CORS, auth, and redirect validation.
# Values:
# - https://www.growrichmindset.in : Production web frontend (do not break)
# - http://localhost:1420         : Tauri desktop app Vite dev server
# - tauri://localhost             : Tauri desktop app production on macOS and Linux
# - http://tauri.localhost        : Tauri desktop app production on Windows
ALLOWED_ORIGINS="https://www.growrichmindset.in,http://localhost:1420,tauri://localhost,http://tauri.localhost"
MONGO_URL=
REDIS_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
SESSION_SECRET=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_User=
GMAIL_Password=
Razorpay_key=
Razorpay_secret=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=
Cloudinary_Cloud_Name=
Cloudinary_API_Key=
Cloudinary_API_Secret=
website_schema=http
